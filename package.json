{
  "name": "bookking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "shared",
    "web"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run typecheck && npm run build --workspace web",
    "typecheck": "npm run typecheck --workspace shared && npm run typecheck --workspace api && npm run typecheck --workspace web",
    "test": "npm run test --workspace api"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
